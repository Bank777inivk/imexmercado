rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper pour vérifier si l'utilisateur est admin (admin ou superadmin)
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin');
    }

    // Helper pour vérifier si l'utilisateur est superadmin
    function isSuperAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // Profils utilisateurs : Propriétaire ou Admin
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Un utilisateur peut créer son profil sans rôle admin/superadmin, ou un administrateur peut le faire.
      allow create: if request.auth != null && (
        (request.auth.uid == userId && (!request.resource.data.keys().hasAny(['role']) || (request.resource.data.role != 'admin' && request.resource.data.role != 'superadmin')))
        || isAdmin()
      );
        
      // Un utilisateur ou admin peut modifier un profil sans toucher au rôle. Seul un Super Admin peut modifier un rôle.
      allow update: if request.auth != null && (
        isSuperAdmin() || 
        ((request.auth.uid == userId || isAdmin()) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      
      allow delete: if isAdmin();
    }
    
    // Paniers : Lecture et écriture autorisées uniquement pour le propriétaire
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Produits : Lecture publique, écriture Admin uniquement
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Paramètres (CMS & Paiement)
    match /settings/{settingId} {
      // Accès public complet en lecture pour tous les paramètres
      allow read: if true;
      // Accès Admin complet en écriture
      allow write: if isAdmin();
    }

    // Paniers abandonnés : Création, modification et suppression publiques pour la gestion du panier abandonné durant le checkout, lecture réservée aux admins
    match /abandoned_carts/{cartId} {
      allow create, update, delete: if true;
      allow read: if isAdmin();
    }

    // Journaux d'emails (logs) : création publique lors de l'envoi d'e-mails, lecture, modification et suppression réservées aux admins
    match /email_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Catégories : Lecture publique, écriture Admin uniquement
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Témoignages : Lecture publique, écriture Admin uniquement
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Avis clients : Lecture et création publiques, modification et suppression Admin
    match /reviews/{reviewId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Commandes : Création et lecture publiques pour le suivi de colis, modification/suppression Admin
    match /orders/{orderId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Abonnés Newsletter : Inscription publique, lecture/gestion réservée aux Admins
    match /subscribers/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Coupons : Lecture (get seulement) publique pour la vérification au checkout, list et write réservés aux admins
    match /coupons/{couponId} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
  }
}

